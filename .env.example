# 0 = agente .NET inerte (o CLR nem carrega o profiler, custo zero).
# 1 = agente ativo nos 4 microsserviços.
NEW_RELIC_ENABLED=0

# License key de ingestão da conta (Profile -> API keys -> tipo INGEST - LICENSE).
# Conta free: 100 GB/mês. Deixe vazio enquanto NEW_RELIC_ENABLED=0.
NEW_RELIC_LICENSE_KEY=

# Região da conta.
#   US -> log-api.newrelic.com
#   EU -> troque log-api.newrelic.com/otlp.nr-data.net por log-api.eu.newrelic.com/otlp.eu01.nr-data.net
#         em kong/kong.compose.yml e kong/kong.k8s.yml
NEW_RELIC_REGION=US

# Tracing do gateway (plugin opentelemetry em kong/kong.compose.yml). Sem estas
# duas, o plugin sobe e não gera span nenhum. sampling_rate 1.0 = 100% capturado,
# ok para demo/teste, caro em produção real.
KONG_TRACING_INSTRUMENTATIONS=off
KONG_TRACING_SAMPLING_RATE=0
